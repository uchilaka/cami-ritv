# The test environment.
#
# Tracked and UNENCRYPTED on purpose (see .gitattributes): this file holds no secrets --
# only the names that make a test run a TEST run. Keeping it readable means CI and a fresh
# clone get the same answer a developer does. Under git-crypt, Dotenv.parse returns {} on a
# locked file without complaining, which is exactly the silent-wrong-environment failure
# this file exists to prevent.
#
# Secrets and machine-specific values -- RAILS_MASTER_KEY, database host/port/credentials --
# belong in .env.test.local, which is never tracked.
NODE_ENV=test
RAILS_ENV=test

# A test run must never resolve a development database. config/database.yml defaults to
# these, config/environments/test.rb forces them back if a dev shell overrode them, and
# spec/rails_helper.rb aborts if the resolved name does not end in "_test". This file is
# where the expected values are actually written down.
APP_DATABASE_NAME_PRIMARY=sails_test
APP_DATABASE_NAME_CRM=twenty_crm_test
