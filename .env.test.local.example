# .env.test.local -- YOUR machine, test environment. Never tracked.
#
# Copy and fill in:
#   cp .env.test.local.example .env.test.local
#
# This file holds ONLY secrets and machine-specific values. The names that make a test run
# a test run -- RAILS_ENV, NODE_ENV, APP_DATABASE_NAME_PRIMARY, APP_DATABASE_NAME_CRM --
# now live in the tracked, unencrypted .env.test. Do not repeat them here: if an older copy
# of this file still sets them, delete those lines. See docs/ENVIRONMENTS.md (R2, R4).

# The TEST master key.
#
# Leave this BLANK if config/credentials/test.key exists -- Rails reads the key file when
# the variable is empty (ActiveSupport::EncryptedFile#key uses `.presence`). Set it only on
# a machine that has no key file.
#
# Getting this wrong is the single most common way to break a test run: a DEVELOPMENT key
# inherited from your shell makes Rails try to decrypt test.yml.enc with it, and the boot
# dies in ActiveSupport::MessageEncryptor::InvalidMessage before a single example runs.
# config/environments/test.rb now drops an inherited value when a key file is present, but
# do not rely on that -- keep this correct.
RAILS_MASTER_KEY=

# Postgres as reachable from this machine, for the TEST databases. The compose app store
# publishes on 16032; host port 5432 is a different project's Postgres. CI overrides all
# of these.
#
# The role must actually exist on that server -- `\du` in psql. A role named here that
# does not exist fails only once something stops masking it with an inherited value.
APP_DATABASE_HOST=127.0.0.1
APP_DATABASE_PORT=16032
APP_DATABASE_USER=
APP_DATABASE_PASSWORD=

PORT=16006
HOSTNAME=localhost
REDIS_URL=redis://localhost:6379/1

# Third-party credentials used by the CRM specs. Safe to leave blank unless you are running
# the specs that talk to Zoho; VCR cassettes cover the rest.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
CRM_ORG_ID=

# Suite behaviour knobs.
RSPEC_FAIL_FAST=false
PII_FILTER_ALLOW_ACCESS_TOKENS=false
UPSERT_INVOICE_BATCH_LIMIT=100
