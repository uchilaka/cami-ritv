#!/usr/bin/env bash
#
# Create a git worktree that can decrypt this repository's git-crypt files.
#
# Why this script exists instead of a plain `git worktree add`:
#
#   git-crypt keeps its symmetric key at $GIT_DIR/git-crypt/keys/default. A
#   worktree gets its OWN $GIT_DIR (.git/worktrees/<name>), which does not
#   inherit that key. Because .gitattributes marks the encrypted paths with
#   `filter=git-crypt` and .git/config sets `filter.git-crypt.required = true`,
#   the checkout hard-fails on the first encrypted file and git rolls the whole
#   worktree back:
#
#     git-crypt: Error: Unable to open key file - have you unlocked/initialized
#                       this repository yet?
#     fatal: .env.development: smudge filter git-crypt failed
#
#   `git-crypt unlock` cannot fix this after the fact: it refuses to run unless
#   the working tree is already clean, and a worktree created with
#   --no-checkout reads as "every file deleted". git-crypt 0.8.0 has no command
#   that installs a key into a gitdir without checking out, so the key has to
#   be placed by hand — in that order:
#
#     1. register the worktree with --no-checkout (nothing to smudge yet)
#     2. install the key into the new gitdir
#     3. check out, now that the filter can decrypt
#
# Usage:
#   bin/worktree-init <name> [branch] [base-ref]
#
#     name       directory created under ../<repo>-worktrees/
#     branch     branch to create or check out (default: <name>)
#     base-ref   ref to branch from (default: origin's default branch)
#
#   bin/worktree-init llm-wiki spike/llm-wiki
#   bin/worktree-init LAR-412 LAR-412/add-widget origin/main
#
# Safe to re-run against a half-created worktree.

set -o errexit
set -o nounset
set -o pipefail

die() {
  echo "ERROR: ⛔ $*" >&2
  exit 1
}

if [[ $# -lt 1 ]]; then
  die "usage: bin/worktree-init <name> [branch] [base-ref]"
fi

WORKTREE_NAME="$1"
BRANCH="${2:-$WORKTREE_NAME}"

# Resolve the main checkout, even when invoked from inside another worktree.
# Worktrees are peers, so the script's own directory is not a reliable anchor —
# --git-common-dir always points at the main .git regardless of which worktree
# we are standing in.
COMMON_DIR="$(git rev-parse --git-common-dir)" || die "not inside a git repository"
if [[ "$COMMON_DIR" != /* ]]; then
  COMMON_DIR="$PWD/$COMMON_DIR"
fi
REPO_ROOT="$(cd "$(dirname "$COMMON_DIR")" && pwd)"
REPO_NAME="$(basename "$REPO_ROOT")"

WORKTREE_PARENT="$(dirname "$REPO_ROOT")/${REPO_NAME}-worktrees"
WORKTREE="$WORKTREE_PARENT/$WORKTREE_NAME"

# If a worktree by this name is already registered somewhere else on disk, adopt
# its real path instead of the conventional one. Without this, re-running against
# an existing worktree that does not sit at ../<repo>-worktrees/<name> would try
# to create a second one and fail on "branch already checked out" — which also
# means such a worktree could never be repaired by this script. Some older
# worktrees are nested inside other worktrees rather than being flat siblings.
ADOPTED_PATH=""
while IFS= read -r registered; do
  if [[ "$(basename "$registered")" == "$WORKTREE_NAME" ]]; then
    ADOPTED_PATH="$registered"
    break
  fi
done <<< "$(git -C "$REPO_ROOT" worktree list --porcelain | sed -n 's/^worktree //p')"

if [[ -n "$ADOPTED_PATH" && "$ADOPTED_PATH" != "$WORKTREE" ]]; then
  echo "WARNING: ⚠️ ${WORKTREE_NAME} is registered at ${ADOPTED_PATH},"
  echo "         not the conventional ${WORKTREE}. Repairing it in place."
  WORKTREE="$ADOPTED_PATH"
fi

if [[ $# -ge 3 ]]; then
  BASE_REF="$3"
elif BASE_REF="$(git -C "$REPO_ROOT" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)"; then
  : # origin's default branch
else
  BASE_REF="origin/main"
fi

# Locate the git-crypt key. GITCRYPT_KEY_FILE may be absolute (preferred: a
# machine-local key outside every checkout, reachable identically from all
# worktrees) or relative, in which case it resolves against the MAIN checkout —
# never against the new worktree, which has no files yet.
KEY_PATH="${GITCRYPT_KEY_FILE:-config/credentials/git-crypt.key}"
case "$KEY_PATH" in
  /*) GITCRYPT_KEY="$KEY_PATH" ;;
  "~/"*) GITCRYPT_KEY="$HOME/${KEY_PATH#\~/}" ;;
  *) GITCRYPT_KEY="$REPO_ROOT/$KEY_PATH" ;;
esac

if [[ ! -f "$GITCRYPT_KEY" ]]; then
  die "🗝️ git-crypt key not found at ${GITCRYPT_KEY}.
  Set GITCRYPT_KEY_FILE to the key's path (see README, 'Set up git-crypt'),
  or export one from an unlocked checkout: git-crypt export-key <path>"
fi

# 1. Register the worktree without checking out — the key must land first.
if git -C "$REPO_ROOT" worktree list --porcelain | grep -qxF "worktree $WORKTREE"; then
  echo "🛠️ Worktree already registered at ${WORKTREE}"
else
  mkdir -p "$WORKTREE_PARENT"
  echo "🛠️ Creating worktree ${WORKTREE} on ${BRANCH} (from ${BASE_REF})"
  if git -C "$REPO_ROOT" show-ref --verify --quiet "refs/heads/${BRANCH}"; then
    git -C "$REPO_ROOT" worktree add --no-checkout "$WORKTREE" "$BRANCH"
  else
    git -C "$REPO_ROOT" fetch --quiet origin || true
    git -C "$REPO_ROOT" worktree add --no-checkout -b "$BRANCH" "$WORKTREE" "$BASE_REF"
  fi
fi

# 2. Install the key into the worktree's own gitdir.
WORKTREE_GIT_DIR="$(git -C "$WORKTREE" rev-parse --absolute-git-dir)"
KEY_DEST="${WORKTREE_GIT_DIR}/git-crypt/keys/default"

if [[ -f "$KEY_DEST" ]]; then
  echo "🗝️ git-crypt key already installed for this worktree"
else
  echo "🗝️ Installing git-crypt key into ${WORKTREE_GIT_DIR}/git-crypt/keys/"
  install -d -m 700 "${WORKTREE_GIT_DIR}/git-crypt/keys"
  install -m 600 "$GITCRYPT_KEY" "$KEY_DEST"
fi

# 3. Check out — the smudge filter now has its key.
echo "🛠️ Checking out working tree"
git -C "$WORKTREE" checkout

# 3b. Repair case. A worktree that was checked out while the key was missing has
# ciphertext sitting in its working tree. Step 3 will not fix that on its own:
# those files exist, so checkout leaves them alone. They have to be re-smudged
# explicitly, and only they — a blanket `checkout --force` would discard real
# work elsewhere in the tree.
if [[ -n "$(git -C "$WORKTREE" ls-files -- '.env.*' | head -1)" ]]; then
  FIRST_ENV="$(git -C "$WORKTREE" ls-files -- '.env.*' | head -1)"
  if [[ -f "${WORKTREE}/${FIRST_ENV}" ]] && head -c 10 "${WORKTREE}/${FIRST_ENV}" | grep -qa GITCRYPT; then
    echo "🛠️ Working tree holds ciphertext — re-smudging git-crypt'd paths"

    ENCRYPTED_PATHS="$(cd "$WORKTREE" && git-crypt status -e 2>/dev/null | sed 's/^ *encrypted: *//' | sed '/^$/d')"
    if [[ -z "$ENCRYPTED_PATHS" ]]; then
      die "could not determine which paths git-crypt manages (is the key valid?)"
    fi

    # Refuse if any encrypted path has STAGED changes — that is deliberate work
    # we would destroy. Unstaged "modifications" are expected here: the clean
    # filter re-encrypts the ciphertext differently, so every affected file looks
    # modified. That is the symptom, not a reason to stop.
    while IFS= read -r path; do
      if [[ -n "$(git -C "$WORKTREE" diff --cached --name-only -- "$path")" ]]; then
        die "${path} has staged changes in ${WORKTREE}.
  Commit or reset them before repairing — re-smudging would discard them."
      fi
    done <<< "$ENCRYPTED_PATHS"

    while IFS= read -r path; do
      git -C "$WORKTREE" checkout --force -- "$path" && echo "   re-smudged ${path}"
    done <<< "$ENCRYPTED_PATHS"
  fi
fi

# 4. Verify decryption actually happened. git-crypt prefixes encrypted blobs
# with a \0GITCRYPT\0 magic header; if a filtered file still carries it, the
# filter passed ciphertext through and the tree will fail confusingly at
# runtime instead of here. Only the header is inspected, never the plaintext.
PROBE_FILE="$(git -C "$WORKTREE" ls-files -- '.env.*' | head -1)"
if [[ -n "$PROBE_FILE" && -f "${WORKTREE}/${PROBE_FILE}" ]]; then
  if head -c 10 "${WORKTREE}/${PROBE_FILE}" | grep -qa GITCRYPT; then
    die "${PROBE_FILE} is still encrypted — git-crypt did not decrypt this worktree"
  fi
  echo "✅ Verified: ${PROBE_FILE} decrypted"
else
  echo "WARNING: ⚠️ No .env.* file found to verify decryption against"
fi

echo
echo "✅ Worktree ready: ${WORKTREE} (${BRANCH})"
echo
echo "   Next, in the new worktree (see docs/DEVELOPMENT.md, 'Finishing a new"
echo "   worktree') — mise and direnv both trust by PATH, so a new worktree is"
echo "   untrusted and an untrusted config breaks PATH resolution:"
echo
echo "     cd ${WORKTREE}"
echo "     mise trust && direnv allow"
echo "     bundle install && yarn install"
echo
echo "   Then copy the gitignored .env.*.local files and the credential keys you"
echo "   need, and verify with: bundle exec thor -T"
