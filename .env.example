# .env -- values that are IDENTICAL in every environment.
#
# Tracked, unencrypted, shared by everyone. Copy nothing from here; .env already exists in
# the repo. This file documents what belongs in it, and what does not.
#
# The full rules live in docs/ENVIRONMENTS.md. The short version:
#
#   .env                     this file's real counterpart -- same in every environment
#   .env.local               YOUR machine: RUBY_ENV, host/port, personal tokens (untracked)
#   .env.<env>               that environment's payload + RAILS_ENV/NODE_ENV (git-crypt)
#   .env.test                the exception -- tracked and UNENCRYPTED, no secrets in it
#   .env.<env>.local         YOUR machine, for that environment: secrets (untracked)
#
# NEVER put a selector in this file. RAILS_ENV, RUBY_ENV and NODE_ENV are all forbidden
# here, because a committed default would make every machine claim the same environment --
# which is precisely how a test run ends up talking to development data.
# spec/environment_isolation_spec.rb enforces this.

# Where the git-crypt key lives. May be absolute, which is the recommended setup once you
# work in worktrees: one key then serves the main checkout and all of them.
GITCRYPT_KEY_FILE=config/credentials/git-crypt.key

# Rails HTTP port. Identical everywhere; per-environment overrides go in .env.<env>.
PORT=16006

# Twenty CRM service port.
CRM_SERVICE_PORT=16010

# Container image tag used by the compose files.
TAG=latest

# Timestamp format for generated filenames (backups, dumps).
FILE_TIMESTAMP_FORMAT=%Y%m%d%H%M%S

# Whether OmniAuth providers are wired up.
APP_CONFIG_OMNIAUTH_ENABLED=false
