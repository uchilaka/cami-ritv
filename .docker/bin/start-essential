#!/usr/bin/env zsh
#
# Routed through the CLI rather than calling `docker compose` directly: compose.yml
# declares its networks `external: true`, so something has to provision them first or
# this path fails on a clean machine with a missing-network error. `services:start`
# does that and then runs the same up/logs pair this script used to duplicate.

bin/thor services:start --profile essential "$@"
