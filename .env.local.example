# .env.local -- YOUR machine. Never tracked.
#
# Loaded in phase 1 by .envrc, BEFORE the environment-specific files, which makes this the
# one legitimate place for a machine to declare which environment it is. See
# docs/ENVIRONMENTS.md (R1, R2).
#
# Copy to .env.local and fill in:
#   cp .env.local.example .env.local

# Which environment this machine is. .envrc refuses to load without it, because the files
# it selects cannot define the variable that selects them.
#
# RAILS_ENV and NODE_ENV do NOT belong here -- they are declared by .env.<env> (R3).
RUBY_ENV=development

# .envrc hard-requires both of these via `:?` guards; direnv aborts without them.
# compose.override.yml also builds the web/worker image names from them.
CONTAINER_REGISTRY_HOST=registry.fly.io
CONTAINER_NAME_PREFIX=cami

# Platform routing. See the LarCity Tailscale + Traefik notes.
#
# PLATFORM_SUBDOMAIN does NOT belong here: compose.yml hard-requires it for the Traefik
# router hosts, and it differs per environment, so it is environment-shaped (R2) and lives
# in .env.<env>.local. See .env.development.local.example and docs/DOCKER_COMPOSE.md.
PLATFORM_ENV=development
PLATFORM_DOMAIN=larcity.tech

# NOTE: the database connection does NOT belong here. The role differs per environment,
# which makes it environment-shaped, so it lives in .env.<env>.local (R2). Keeping it
# here is how a development shell came to point port 5432 at postgres.development.larcity
# -- a different project's server that rejects this project's user.

# Hostname used in generated URLs.
HOSTNAME=localhost

# Personal tokens. Yours, not the team's.
LINEAR_API_KEY=
APP_CONFIG_JWT_SECRET_KEY=

# Which compose profile the `mise run` tasks use -- every task in mise.toml passes
# `--profile $COMPOSE_PROFILE`, and mise.toml declares it `required = true`, so mise
# refuses to run without it.
#
# Every service in compose.yml sits behind a profile, so a bare `docker compose up` starts
# nothing. Choices: essential, crm, standalone, batteries-included, all. Use
# `batteries-included` for the full local Docker stack (or `standalone` without CRM). See
# docs/DOCKER_COMPOSE.md.
#
# `bin/thor services:start` does NOT read this; it has its own --profile option.
COMPOSE_PROFILE=batteries-included
