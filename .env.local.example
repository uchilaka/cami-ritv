# .env.local -- YOUR machine. Never tracked.
#
# Loaded in phase 1 by .envrc, BEFORE the environment-specific files, which makes this the
# one legitimate place for a machine to declare which environment it is. See
# docs/ENVIRONMENTS.md (R1, R2).
#
# Copy to .env.local and fill in:
#   cp .env.local.example .env.local

# Which environment this machine is. .envrc refuses to load without it, because the files
# it selects cannot define the variable that selects them.
#
# RAILS_ENV and NODE_ENV do NOT belong here -- they are declared by .env.<env> (R3).
RUBY_ENV=development

# .envrc hard-requires both of these via `:?` guards; direnv aborts without them.
CONTAINER_REGISTRY_HOST=registry.fly.io
CONTAINER_NAME_PREFIX=cami

# Platform routing. See the LarCity Tailscale + Traefik notes.
PLATFORM_ENV=development
PLATFORM_DOMAIN=larcity.tech

# Postgres as reachable FROM YOUR MACHINE. The compose stack publishes the app store on
# 16032; a host-installed Postgres is usually 5432.
APP_DATABASE_HOST=127.0.0.1
APP_DATABASE_PORT=16032
APP_DATABASE_USER=postgres
APP_DATABASE_PASSWORD=

# Hostname used in generated URLs.
HOSTNAME=localhost

# Personal tokens. Yours, not the team's.
LINEAR_API_KEY=
APP_CONFIG_JWT_SECRET_KEY=

# Which compose profile `thor lx-cli:services:start` brings up by default.
COMPOSE_PROFILE=essential
