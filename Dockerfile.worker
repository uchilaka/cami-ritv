# syntax = docker/dockerfile:1.2
FROM ruby:3.4.4 AS base
# Install git-crypt and other dependencies
RUN apt-get update -qq && \
  apt-get install -y --no-install-recommends \
  build-essential \
  git-crypt \
  pkg-config \
  libvips \
  libpq-dev \
  zsh \
  && rm -rf /var/lib/apt/lists/*

# Set zsh as the default shell with a minimal .zshrc (dev/debug ergonomics).
# oh-my-zsh is layered on top in the `dev` stage.
# TODO: [LAR-355] This belongs in the `dev` stage -- installing zsh and running chsh in the
#   shared `base` stage leaks dev tooling into the runtime image (and chsh comes from
#   `passwd`, which is not explicitly installed).
ENV SHELL=/usr/bin/zsh
RUN chsh -s /usr/bin/zsh root && \
  printf '%s\n' \
  'autoload -Uz compinit && compinit' \
  'setopt AUTO_CD' \
  'HISTFILE=~/.zsh_history' \
  'HISTSIZE=10000' \
  'SAVEHIST=10000' \
  'setopt SHARE_HISTORY' \
  "PROMPT='%n@%m %~ %# '" \
  > /root/.zshrc

FROM base AS src
ENV WORKDIR="/opt/project/src"
RUN mkdir -p $WORKDIR
# Set up your app directory
WORKDIR $WORKDIR
# Copy the source code into the container
COPY . .

FROM src AS worker

ARG RAILS_ENV
ARG DATABASE_URL
# Passed through by docker-compose (see the `worker` build args). Without this ARG
# the value never reaches the build environment and ./bin/unlock-repo no-ops.
ARG GITCRYPT_KEY_BASE64

# Default to production environment, but allow override at runtime
ENV RAILS_ENV="${RAILS_ENV:-production}"

# Temporarily disable environment variable checks during build, as some may not be set until runtime on Render
ENV APP_CONFIG_CHECK_REQUIRED_VARS=${APP_CONFIG_CHECK_REQUIRED_VARS:-no}

ENV APP_CONFIG_CHECK_ENV_VARS=${APP_CONFIG_CHECK_ENV_VARS:-no}
ENV APP_CONFIG_SKIP_PAYPAL_INIT_CHECK=${APP_CONFIG_SKIP_PAYPAL_INIT_CHECK:-yes}
ENV APP_CONFIG_SKIP_ZOHO_INIT_CHECK=${APP_CONFIG_SKIP_ZOHO_INIT_CHECK:-yes}
ENV APP_CONFIG_SKIP_TWENTY_CRM_INIT_CHECK=${APP_CONFIG_SKIP_TWENTY_CRM_INIT_CHECK:-yes}

# See documentation on accessing secret files at runtime on Render:
# https://render.com/docs/docker-secrets#accessing-secret-files-at-runtime
#
# Every RUN below that needs a secret mounts it itself: BuildKit tears the mount
# down at the end of each RUN, so a mount on one instruction is not visible to the
# next. Secrets therefore never land in an image layer.

# Decrypt credentials and git-crypt files during build ensuring that all sensitive
# information is available for the build process without being included in the
# image layers. This allows you to keep your secrets secure while still enabling
# a successful build.
#
# ./bin/unlock-repo reads GITCRYPT_KEY_BASE64 (above) or the mounted key file.
RUN --mount=type=secret,id=git-crypt.key,dst=/run/secrets/git-crypt.key \
  ./bin/unlock-repo

# Symlink /etc/secrets/<env>.key into config/credentials. This only does anything
# on Render, which populates /etc/secrets during the build; elsewhere the script
# warns and exits cleanly. Deliberately NOT given a BuildKit secret mount: doing so
# would bake a symlink into the image pointing at a path that exists only while the
# mount is live, which breaks Rails' credentials fallback everywhere else.
RUN ./bin/link-key-file

# Run your build script (the one we made in the previous step). It re-runs
# unlock-repo, so it needs the git-crypt key mounted too; the credentials key is
# mounted where Rails looks for it in case a bundler hook reads credentials.
RUN --mount="type=secret,id=${RAILS_ENV}.key,dst=${WORKDIR}/config/credentials/${RAILS_ENV}.key" \
  --mount=type=secret,id=git-crypt.key,dst=/run/secrets/git-crypt.key \
  ./bin/worker-build

# Specify the entrypoint command to run your Rails worker
CMD ["bundle", "exec", "rails", "solid_queue:start"]

# ---------------------------------------------------------------------------
# Dev/debug image: layers oh-my-zsh on top of the runtime image.
# zsh itself is already installed and configured in the `base` stage.
# Build with: docker build --target dev -f Dockerfile.worker .
# ---------------------------------------------------------------------------
FROM worker AS dev

# Install oh-my-zsh and point .zshrc at it (git is available from the base ruby image)
# TODO: [LAR-355] Pin this clone to a tag/commit SHA -- an unpinned clone makes the dev image
#   non-reproducible. Lower risk now that `dev` is no longer the default build target.
RUN git clone --depth=1 https://github.com/ohmyzsh/ohmyzsh.git /root/.oh-my-zsh && \
  printf '%s\n' \
  'export ZSH="$HOME/.oh-my-zsh"' \
  'ZSH_THEME="robbyrussell"' \
  'plugins=(git)' \
  'source $ZSH/oh-my-zsh.sh' \
  > /root/.zshrc

# Inherits CMD from the `worker` stage

# ---------------------------------------------------------------------------
# Default build target. `dev` above must not be the last stage in this file, or
# a bare `docker build -f Dockerfile.worker .` (and any compose build without an
# explicit `target:`) would produce the dev image instead of the runtime one.
# ---------------------------------------------------------------------------
FROM worker AS runtime
