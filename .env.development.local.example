# .env.development.local -- YOUR machine, development environment. Never tracked.
#
# Copy and fill in:
#   cp .env.development.local.example .env.development.local
#
# Secrets and machine-specific values only. RAILS_ENV and NODE_ENV are declared by the
# tracked .env.development (docs/ENVIRONMENTS.md, R3); do not repeat them here.

# The DEVELOPMENT master key.
#
# Leave BLANK if config/credentials/development.key exists -- Rails falls back to the key
# file when this is empty.
#
# Be aware of what setting it costs you: direnv exports this into your whole shell, and it
# then takes precedence over EVERY environment's key file. That is what made
# `RAILS_ENV=test bundle exec ...` fail with MessageEncryptor::InvalidMessage. Prefer the
# key file; see docs/ENVIRONMENTS.md (R5).
RAILS_MASTER_KEY=

# Postgres as reachable from this machine, for DEVELOPMENT.
#
# Lives here rather than in .env.local because the role differs per environment, which
# makes the connection environment-shaped (docs/ENVIRONMENTS.md R2). The compose app
# store publishes on 16032; host port 5432 is a DIFFERENT project's Postgres.
#
# All four of USER / PASSWORD / NAME_PRIMARY / NAME_CRM are written ${VAR:?...} in
# compose.yml, and `:?` rejects an EMPTY value just as it rejects an unset one -- so
# leaving the two blanks below as-is makes every `docker compose` command abort, not
# fall back to a default. See docs/DOCKER_COMPOSE.md.
APP_DATABASE_NAME_PRIMARY="sails_development"
APP_DATABASE_NAME_CRM="twenty_crm_development"
APP_DATABASE_HOST=127.0.0.1
APP_DATABASE_PORT=16032
APP_DATABASE_USER=
# Required non-empty even though compose.override.yml does `APP_DATABASE_PASSWORD: !reset
# null` and the local app-store runs `trust` auth: Compose interpolates every file BEFORE
# merging, so the base file's guard fires first and no container ever receives the value.
APP_DATABASE_PASSWORD=

# Thread and worker counts for the local server.
RAILS_MAX_THREADS=5
RAILS_MIN_THREADS=3
RAILS_QUEUE_THREADS=3
WEB_CONCURRENCY=1

# Local development conveniences.
APP_DEBUG_MODE=false
DISABLE_SPRING=true
ENV_CONSIDER_ALL_REQUESTS_LOCAL=true
ENV_DEBUG_ASSETS=true
RAILS_LIVE_RELOAD_ENABLED=true
MAILHOG_ENABLED=true
SEND_EMAILS_ENABLED=false
LAUNCHY_APPLICATION=browser
BUILDKIT_PROGRESS=plain

# macOS: Ruby forks crash without this when a process has already initialised ObjC.
OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES

# Your LAN, for the platform routing checks.
LAN_SUBNET_MASK=192.168.1.0/24
HOSTNAME=localhost

# Platform routing. compose.yml builds the Traefik router hosts for `web` and `crm-app`
# from this -- `accounts.${PLATFORM_SUBDOMAIN}` and `accounts-crm.${PLATFORM_SUBDOMAIN}` --
# and guards it with `:?`, so a compose command with this unset or blank aborts before it
# reads anything else.
#
# It lives here rather than in .env.local because it differs per environment, which makes
# it environment-shaped (docs/ENVIRONMENTS.md R2). PLATFORM_ENV and PLATFORM_DOMAIN are in
# .env.local.example.
#
# TODO: Will be deprecated in favor of PLATFORM_DOMAIN.
PLATFORM_SUBDOMAIN=tunnel.larcity.dev
PLATFORM_DOMAIN=tunnel.larcity.dev

# Deploy hooks and workspace ids. Yours, not the team's.
APP_DEPLOY_STAGING_HOOK_URL=
APP_DEPLOY_PRODUCTION_HOOK_URL=
RENDER_WORKSPACE_ID=

UPSERT_INVOICE_BATCH_LIMIT=100
HOMEBREW_BUNDLE_FILE=Brewfile

# Twenty CRM (the `crm` profile) knobs that compose.yml interpolates without a default.
# None is required: `${VAR}` with no `:?` only warns and defaults to a blank string. They
# are declared blank here so a stock setup does not print a wall of
# "variable is not set. Defaulting to a blank string." on every compose command.
#
# STORAGE_S3_* matter only if you switch STORAGE_TYPE away from `local`.
SMTP_USER=
STORAGE_S3_REGION=
STORAGE_S3_NAME=
STORAGE_S3_ENDPOINT=
DISABLE_DB_MIGRATIONS=
DISABLE_CRON_JOBS_REGISTRATION=
