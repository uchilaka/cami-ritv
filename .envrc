#!/usr/bin/env zsh

set -e
# TODO: [LAR-328] Explore templatizing this file for use across multiple environments... or better yet, these templates
# are getting pretty close to the point where they should be moved into a shared library or simplified in a
# way that they can be useful for dev environment setup but otherwise transparent in favor of environment-specific
# configuration files that are loaded by this file. For example, we could have .envrc load .env.lab.local and
# .env.staging.local, etc. and then we can have environment-specific configuration in those files instead of this one.

# TODO: [LAR-329] Refactor to retrieve value from .tool-versions file
export NODENV_VERSION=22.14.0

# TODO: [LAR-330] Deprecate the use of Direnv in Staging+ environments
# NOTE: direnv always evaluates .envrc with bash (the shebang is ignored), so
# zsh-only expansions like ${0:a:h} silently resolve blank here. git resolves
# the checkout root (including worktrees) regardless of the evaluating shell.
export PROJECT_ROOT="$(git rev-parse --show-toplevel)"

# Precedence should match this chart: https://github.com/bkeepers/dotenv?tab=readme-ov-file#customizing-rails
#
# Loaded in TWO phases. The environment-specific paths interpolate RUBY_ENV, but
# RUBY_ENV is itself defined in a dotenv file. Building all four paths up front expands
# RUBY_ENV while it is still empty, so ".env.${RUBY_ENV}" becomes ".env." and is
# silently skipped -- and any shell that appears to work only does so because RUBY_ENV
# was already exported from somewhere else.
base_env_files=(
  "${PROJECT_ROOT}/.env"
  "${PROJECT_ROOT}/.env.local"
)
set -a
for env_file in "${base_env_files[@]}"; do
  if [[ -f "$env_file" ]]; then
    printf " ⚙️ $(basename "$env_file") "
    source "$env_file"
  fi
done
set +a

# Checked BETWEEN the phases: the next line interpolates RUBY_ENV into a filename, so
# this is the last point at which a missing value can be reported as itself rather than
# as a mysteriously absent config file.
: "${RUBY_ENV:?RUBY_ENV is not set. Set it in your shell or in .env.local -- never in .env, where a committed default would make every machine claim the same environment. See docs/ENVIRONMENTS.md. Example: RUBY_ENV=development}"

environment_file="${PROJECT_ROOT}/.env.${RUBY_ENV}"
if [[ ! -f "$environment_file" ]]; then
  printf " ⚠️ Environment file not found: %s\n" "$environment_file" >&2
  return 1
fi
env_files=(
  "$environment_file"
  "${PROJECT_ROOT}/.env.${RUBY_ENV}.local"
)
set -a
for env_file in "${env_files[@]}"; do
  if [[ -f "$env_file" ]]; then
    printf " ⚙️ $(basename "$env_file") "
    source "$env_file"
  fi
done
set +a

# [LAR-358] Reclaim PROJECT_ROOT from the dotenv files.
#
# Line 17 derives this correctly, including inside worktrees -- but the loops above
# source their files under `set -a`, so a PROJECT_ROOT declared in any of them
# overwrites that value for everything downstream. Removing the assignment from the
# tracked .env.<env> files is necessary but NOT sufficient: the .env.<env>.local files
# are gitignored, so a stale one on any machine (or copied into a worktree during
# bootstrap) silently reinstates the bug and no change shipped from this repo can
# reach it. Re-derive here instead, and say so when it happens -- a silent correction
# would hide the very regression this is guarding.
#
# Everything path-shaped that this file derives (DATABASE_ROOT_DIR, the compose list,
# the git-crypt key lookup) is computed BELOW this point, so it all picks up the
# corrected value.
project_root_from_git="$(git rev-parse --show-toplevel)"
if [[ "$PROJECT_ROOT" != "$project_root_from_git" ]]; then
  printf " ⚠️ PROJECT_ROOT was set to %s by a dotenv file; re-deriving as %s (LAR-358) " \
    "$PROJECT_ROOT" "$project_root_from_git" >&2
  export PROJECT_ROOT="$project_root_from_git"
fi
unset project_root_from_git

: "${CONTAINER_REGISTRY_HOST:?CONTAINER_REGISTRY_HOST is not set. Please set CONTAINER_REGISTRY_HOST to the appropriate container registry host (e.g., registry.fly.io).}"
: "${CONTAINER_NAME_PREFIX:?CONTAINER_NAME_PREFIX is not set. Please set CONTAINER_NAME_PREFIX to the appropriate container name prefix (e.g., cami).}"

# Build app database name from environment variables.
#
# NOTE: Do not rely on this export being correct for the test environment.
#export APP_DATABASE_NAME_PRIMARY="${APP_DATABASE_NAME_PRIMARY:-sails_$RUBY_ENV}"
#export APP_DATABASE_NAME_CRM="${APP_DATABASE_NAME_CRM:-twenty_crm_$RUBY_ENV}"

# Merging compose files: https://docs.docker.com/compose/how-tos/multiple-compose-files/merge/#how-to-merge-multiple-compose-files
export COMPOSE_PATH_SEPARATOR=":" # On Windows, this should be ";"
# IMPORTANT: The order of the compose files matters. The latter files
# will override the previous ones. For example, compose.override.yml
# should be able to override compose.${RUBY_ENV}.yml, and the beta
# postgres compose should be able to override both if needed.
compose_files=(
  "${PROJECT_ROOT}/compose.yml"
  "${PROJECT_ROOT}/docker-compose.yml"
  "${PROJECT_ROOT}/compose.${RUBY_ENV}.yml"
  "${PROJECT_ROOT}/compose.override.yml"
  "${PROJECT_ROOT}/docker-compose.override.yml"
)
COMPOSE_FILE=""
for compose_file in "${compose_files[@]}"; do
  if [[ -f "$compose_file" ]]; then
    printf " 🐳 Adding $(basename "$compose_file") to COMPOSE_FILE "
    export COMPOSE_FILE="${COMPOSE_FILE:+$COMPOSE_FILE$COMPOSE_PATH_SEPARATOR}$compose_file"
  else
    printf " ⚠️ Compose file not found: $compose_file. Skipping. "
  fi
done

# TODO: [LAR-328] Refactor to have the ./config/dotenvs/.env.<environment>.erb files be the
# source of truth for environment variables and then have this file load those files
# instead of having environment variables defined in multiple places. This would also
# allow us to templatize the .env files and use them across multiple environments
# without having to duplicate environment variable definitions across multiple .env files.

# Attempt to set GITCRYPT_KEY_BASE64 if GITCRYPT_KEY_FILE is set and the file exists
export GITCRYPT_KEY_FILE="${GITCRYPT_KEY_FILE:-config/credentials/git-crypt.key}"
# GITCRYPT_KEY_FILE may be absolute — pointing at a machine-local key outside
# every checkout is the recommended setup once you work in worktrees, since one
# canonical key then serves the main repo and all of them. Only prefix
# PROJECT_ROOT when the path is relative; concatenating it onto an absolute path
# yields nonsense, and the failure is silent (GITCRYPT_KEY_BASE64 just never
# gets set).
case "$GITCRYPT_KEY_FILE" in
  /*) KEY_SRC_FILE="$GITCRYPT_KEY_FILE" ;;
  "~/"*) KEY_SRC_FILE="${HOME}/${GITCRYPT_KEY_FILE#\~/}" ;;
  *) KEY_SRC_FILE="${PROJECT_ROOT}/${GITCRYPT_KEY_FILE}" ;;
esac
if [[ -f "$KEY_SRC_FILE" ]]; then
  printf " 🛠️ Setting \$GITCRYPT_KEY_BASE64 from $GITCRYPT_KEY_FILE "
  export GITCRYPT_KEY_BASE64=$(cat "$KEY_SRC_FILE" | base64)
else
  printf " ⚠️ \$GITCRYPT_KEY_FILE is not found @ $KEY_SRC_FILE. Skipping setting \$GITCRYPT_KEY_BASE64 "
fi

# Knapsack Pro configuration for parallel test execution
export KNAPSACK_PRO_CI_NODE_BUILD_ID=$(date -u +"%Y-%m-%dT%H:%M:%S%z")
export KNAPSACK_PRO_COMMIT_HASH=$(git rev-parse HEAD)
export KNAPSACK_PRO_BRANCH=$(git rev-parse --abbrev-ref HEAD)

# Database root directory
export DATABASE_ROOT_DIR="${PROJECT_ROOT}/db/${RUBY_ENV}"

# NGROK profile config path
export NGROK_PROFILE_CONFIG_PATH="$HOME/.ngrok2/ngrok.yml"

# Fly.io application name
export FLY_APP_NAME_PREFIX="cami-${RUBY_ENV}"
